{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "PseSignalDesk.slnx"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "backend: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "PseSignalDesk.slnx"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc", "$tsc-watch"]
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v.*",
          "endsPattern": "Local:\\s+http://localhost:5173"
        }
      }
    }
  ]
}
