{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "PseSignalDesk.slnx"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "backend: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "PseSignalDesk.slnx"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "backend: free port 5236",
      "detail": "SIGTERM whatever still listens on :5236 — usually a `dotnet run` orphaned to PPID 1 when a terminal closed — so the API launch configuration can bind.",
      "type": "shell",
      "command": "pids=$(lsof -nP -iTCP:5236 -sTCP:LISTEN -t); if [ -n \"$pids\" ]; then echo \"freeing :5236 — SIGTERM to $pids\"; kill -TERM $pids; sleep 2; lsof -nP -iTCP:5236 -sTCP:LISTEN || echo ':5236 is free now'; else echo ':5236 is already free'; fi",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc", "$tsc-watch"]
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v.*",
          "endsPattern": "Local:\\s+http://localhost:5173"
        }
      }
    }
  ]
}
