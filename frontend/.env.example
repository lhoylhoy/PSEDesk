# Base URL of the PSE Signal Desk .NET API.
# Defaults to http://localhost:5236 when unset, matching the WebApi launch profile.
VITE_API_BASE_URL=http://localhost:5236

# Shared operator key, sent as `X-PseDesk-Key` on POST/PUT/PATCH/DELETE.
#
# Leave this unset for the personal loopback desk: `Compliance:DeploymentMode=PersonalLocal`
# needs no key, and reads never carry one. Set it ONLY when the API runs as
# `LicensedCommercial` with `PSEDESK_OPERATOR_API_KEY` configured on the server — and remember
# that a key shipped in a browser bundle is readable by anyone who loads the page, so it is a
# single-operator convenience, not per-user authentication.
# VITE_OPERATOR_API_KEY=
