{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pse_signals.db"
  },
  "OllamaCloud": {
    "BaseUrl": "https://ollama.com",
    "Model": "deepseek-v4.1-flash",
    "FastExtractionModel": "glm-5.3-flash",
    "EmbeddingModel": "nomic-embed-text",
    "ApiKey": "",
    "RequestTimeoutSeconds": 120
  },
  "KnowledgeBase": {
    "RootPath": "knowledge-base",
    "MaxSnippets": 6,
    "MaxChunkCharacters": 1600,
    "EnableEmbeddings": true,
    "IndexOnStartup": true
  },
  "MarketData": {
    "YahooFinanceBaseUrl": "https://query1.finance.yahoo.com",
    "YahooFinanceFallbackBaseUrl": "https://query2.finance.yahoo.com",
    "UserAgent": "PseSignalDesk-PersonalResearch/0.1 (local-noncommercial)",
    "IndexYahooSymbols": [ "PSEI.PS" ],
    "IndexProxyConstituents": [
      "TEL",
      "SM",
      "SMPH",
      "ALI",
      "BDO",
      "BPI",
      "ICT",
      "JFC",
      "MER",
      "AC",
      "URC",
      "GLO"
    ],
    "PseEdgeAnnouncementsUrl": "https://edge.pse.com.ph/announcements/search.ax",
    "PseEdgeCompanyDisclosuresUrl": "https://edge.pse.com.ph/companyDisclosures/search.ax",
    "EnablePseEdgeHistory": true,
    "PseEdgeChartUrl": "https://edge.pse.com.ph/common/DisclosureCht.ax",
    "PseEdgeSymbolSearchUrl": "https://edge.pse.com.ph/autoComplete/searchCompanyNameSymbol.ax",
    "PseEdgeCompanyPageUrl": "https://edge.pse.com.ph/companyPage/stockData.do",
    "DisclosurePagesToScan": 2,
    "PseDailyQuotationUrlTemplates": [],
    "Us10YahooSymbol": "^TNX",
    "BrentYahooSymbol": "BZ=F",
    "EpheYahooSymbol": "EPHE",
    "LookbackCalendarDays": 420,
    "MaxConcurrency": 8,
    "RequestTimeoutSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Compliance": {
    "DeploymentMode": "PersonalLocal",
    "EnforceLoopbackInPersonalMode": true,
    "OperatorApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
